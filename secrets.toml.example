# Nonsecret deployment settings. Cloud uses the temporary Q38 daily budget policy.
PP_DEPLOYMENT = "cloud"
PP_STORE = "local"
# Set credentials only in Community Cloud; never Git or chat.
ODDS_API_KEY = "REPLACE_IN_STREAMLIT_SETTINGS_ONLY"
APP_PASSPHRASE = "CHOOSE_AND_SET_ONLY_IN_STREAMLIT_SETTINGS"

# TASK-17: Josh enters actual values himself; agents must never read the real file.
# Bet logs and settlement turn on automatically with this service-account block.
CONSTANTS_SHEET_ID = "PASTE_SPREADSHEET_ID_HERE"
[gcp_service_account]
type = "service_account"
project_id = "REPLACE_LOCALLY"
private_key_id = "REPLACE_LOCALLY"
private_key = "REPLACE_LOCALLY"
client_email = "REPLACE_LOCALLY"
client_id = "REPLACE_LOCALLY"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "REPLACE_LOCALLY"
